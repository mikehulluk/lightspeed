cabal-version:      3.0
name:               lightspeed
-- Released on its own: this must match the haskell-v* tag of the release,
-- which ./check-release.sh checks. See the repository README.
version:            0.0.0
synopsis:           Fast, zoomable plots of very large series
description:
  Min/max level-of-detail pyramids for very large series, cached in HDF5.
  The Haskell implementation of lightspeed; it shares the cache file format
  with the Python package.
license:            MIT
license-file:       LICENSE
author:             Mike Hull
maintainer:         mikehulluk@gmail.com
category:           Data, Graphics
build-type:         Simple
extra-doc-files:    README.md

common warnings
  ghc-options: -Wall

library
  import:           warnings
  exposed-modules:  Lightspeed
  other-modules:    Paths_lightspeed
  autogen-modules:  Paths_lightspeed
  build-depends:    base >=4.18 && <5
  hs-source-dirs:   src
  default-language: GHC2021

test-suite lightspeed-test
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test
  build-depends:    base >=4.18 && <5, lightspeed
  default-language: GHC2021
